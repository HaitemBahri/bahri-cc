# AWS IDs for CDK. Real values live in 1Password; run commands with:
#   op run --env-file=infra/.env.example -- <command>
AWS_ACCOUNT_ID=op://bahri-cc/aws/account-id
HOSTED_ZONE_ID=op://bahri-cc/aws/hosted-zone-id
ALERT_EMAIL=op://bahri-cc/aws/alert-email
PREVIEW_TOKEN=op://bahri-cc/preview-token/credential
# Set after CertStack is deployed (see docs/runbooks/aws-setup.md).
CERTIFICATE_ARN=op://bahri-cc/aws/certificate-arn
