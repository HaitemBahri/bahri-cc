---
import { navItems, pageHref } from "@/config/nav";
import { t, type Lang } from "@/i18n/ui";

interface Props {
  lang: Lang;
  class?: string;
  linkClass?: string;
}

const { lang, class: className, linkClass } = Astro.props;
const label = t(lang);
const current = Astro.url.pathname;
---

<ul class={className}>
  {
    navItems.map(({ key, slug }) => {
      const href = pageHref(lang, slug);
      return (
        <li>
          <a href={href} class={linkClass} aria-current={href === current ? "page" : undefined}>
            {label(key)}
          </a>
        </li>
      );
    })
  }
</ul>
