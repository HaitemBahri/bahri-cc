---
import { render } from "astro:content";
import type { Role } from "@/lib/experience";
import { t, type Lang } from "@/i18n/ui";

interface Props {
  lang: Lang;
  roles: Role[];
}

const { lang, roles } = Astro.props;
const label = t(lang);
const month = new Intl.DateTimeFormat(lang, { month: "short", year: "numeric", timeZone: "UTC" });
const format = (yearMonth: string) => month.format(new Date(`${yearMonth}-01T00:00:00Z`));

const items = await Promise.all(roles.map(async (role) => ({ role, Content: (await render(role.entry)).Content })));
---

<!-- Logical border and offsets so the line sits on the start side in both LTR and RTL. -->
<ol class="border-border ms-2 border-s">
  {
    items.map(({ role, Content }) => (
      <li class="relative ps-6 pb-10 last:pb-0 md:grid md:grid-cols-[10rem_1fr] md:gap-6">
        <span class="bg-primary-accent ring-background absolute -start-1.5 top-1.5 size-3 rounded-full ring-4" aria-hidden="true" />
        <p class="text-muted-foreground text-sm md:pt-0.5">
          <time datetime={role.start}>{format(role.start)}</time> –{" "}
          {role.end ? <time datetime={role.end}>{format(role.end)}</time> : label("experience.present")}
        </p>
        <div>
          <h2 class="mt-1 text-xl font-semibold md:mt-0">
            {role.entry.data.title}
            {
              role.company && (
                <>
                  {" · "}
                  <bdi dir="ltr">{role.company}</bdi>
                </>
              )
            }
          </h2>
          <p class="text-muted-foreground mt-1 text-sm">{role.entry.data.location}</p>
          <div class="mt-3 [&_p]:leading-relaxed">
            <Content />
          </div>
        </div>
      </li>
    ))
  }
</ol>
