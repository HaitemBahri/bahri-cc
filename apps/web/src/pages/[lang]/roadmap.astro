---
import { getEntry } from "astro:content";
import RoadmapPhases from "@/components/RoadmapPhases.astro";
import { getPhases } from "@/lib/roadmap";
import { langs, t, type Lang } from "@/i18n/ui";
import BaseLayout from "@/layouts/BaseLayout.astro";

export const getStaticPaths = () => langs.map((lang) => ({ params: { lang } }));

const lang = Astro.params.lang as Lang;
const label = t(lang);
const page = await getEntry("pages", `${lang}/roadmap`);
if (!page) throw new Error(`Missing content: pages/${lang}/roadmap.md`);
const phases = await getPhases(lang);
---

<BaseLayout lang={lang} title={page.data.title} description={page.data.description}>
  <h1 class="py-8 text-4xl font-semibold md:pt-16 md:text-5xl">{label("nav.roadmap")}</h1>

  <RoadmapPhases phases={phases} />

  {
    phases.map((phase, i) => (
      <section id={phase.id} class="mt-16 max-w-3xl scroll-mt-24">
        <h2 class="text-2xl font-semibold">
          <bdi>{i + 1}.</bdi> {phase.title}
        </h2>
        <p class="text-muted-foreground mt-1 text-sm">{phase.period}</p>
        <p class="text-muted-foreground mt-4 text-lg">{phase.overview}</p>

        {phase.sections.map((section) => (
          <>
            <h3 class="mt-8 text-lg font-semibold">{section.heading}</h3>
            <ul class="mt-3 list-disc space-y-2 ps-5">
              {section.items.map((item) => (
                <li>
                  {item.label && (
                    <strong>
                      {item.label}
                      {item.text && ":"}
                    </strong>
                  )}{" "}
                  {item.text}
                  {item.items && (
                    <ul class="mt-2 list-[circle] space-y-1 ps-5">
                      {item.items.map((sub) => (
                        <li>
                          {sub.label && <strong>{sub.label}:</strong>} {sub.text}
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </ul>
          </>
        ))}

        <details class="group mt-8">
          <summary class="text-primary-accent w-fit cursor-pointer rounded-sm underline-offset-4 outline-none hover:underline focus-visible:ring-3 focus-visible:ring-outline">
            {label("roadmap.prose")}
          </summary>
          <div class="text-muted-foreground mt-4 space-y-4 leading-relaxed">
            {phase.prose.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </details>
      </section>
    ))
  }
</BaseLayout>
