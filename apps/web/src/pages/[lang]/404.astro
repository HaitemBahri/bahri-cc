---
import { Button } from "@/components/starwind/button";
import { pageHref } from "@/config/nav";
import { langs, t, type Lang } from "@/i18n/ui";
import BaseLayout from "@/layouts/BaseLayout.astro";

// Served with status 404 by the CloudFront edge functions (BUILD-1421).
export const getStaticPaths = () => langs.map((lang) => ({ params: { lang } }));

const lang = Astro.params.lang as Lang;
const label = t(lang);
---

<BaseLayout lang={lang} title={label("notFound.title")} description={label("notFound.text")} noindex>
  <div class="flex min-h-[60dvh] flex-col items-center justify-center gap-4 text-center">
    <p class="text-muted-foreground text-7xl font-semibold md:text-8xl" aria-hidden="true">404</p>
    <h1 class="text-3xl font-semibold md:text-4xl">{label("notFound.title")}</h1>
    <p class="text-muted-foreground max-w-md text-lg">{label("notFound.text")}</p>
    <div class="mt-4 flex flex-wrap items-center justify-center gap-x-6 gap-y-3">
      <Button href={pageHref(lang, "")}>{label("notFound.home")}</Button>
      <a
        href={pageHref(lang, "contact")}
        class="text-primary-accent rounded-sm underline-offset-4 outline-none hover:underline focus-visible:ring-3 focus-visible:ring-outline"
        >{label("button.contact")}</a
      >
    </div>
  </div>
</BaseLayout>
