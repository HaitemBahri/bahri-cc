---
import { getEntry } from "astro:content";
import { langs, type Lang } from "@/i18n/ui";
import BaseLayout from "@/layouts/BaseLayout.astro";

export const getStaticPaths = () => langs.map((lang) => ({ params: { lang } }));

const lang = Astro.params.lang as Lang;
const page = await getEntry("pages", `${lang}/home`);
if (!page) throw new Error(`Missing content: pages/${lang}/home.md`);
---

<BaseLayout lang={lang} title={page.data.title} description={page.data.description}>
  <h1>{page.data.title}</h1>
</BaseLayout>
